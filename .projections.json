{
  "*": {
    "make": "cd build3 && cmake -DCMAKE_BUILD_TYPE=Debug -DENABLE_TESTING=ON .. && make -j8",
    "start": "leanfs3 -s -d -f -o max_read=1048576 /mnt/leanfs"
  },
  "*.fio": {
    "dispatch": "fio --directory=/mnt/leanfs %"
  },
  "src/*.cc": {
    "alternate": "test/{dirname}/test_{basename}.cc",
    "type": "src"
  },
  "benchmark/src/*.cc": {
    "alternate": "benchmark/src/include/benchmark/{}.h",
    "type": "src"
  },
  "test/**/test_*.cc": {
    "alternate": "src/{}.cc",
    "type": "test",
    "make": "cd build3 && make -j4 test_{basename}",
    "dispatch": "./build3/test/test_{basename}"
  },
  "src/include/*.h": {
    "alternate": "src/{}.cc",
    "type": "header"
  },
  "benchmark/src/include/benchmark/*.h": {
    "alternate": "benchmark/src/{}.cc",
    "type": "header"
  }
}
